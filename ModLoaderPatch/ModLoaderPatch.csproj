<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <DebugSymbols>False</DebugSymbols>
        <DebugType>None</DebugType>
    </PropertyGroup>

    <PropertyGroup>
        <GodotProjectDir>$(MSBuildProjectDirectory)</GodotProjectDir>
        <GodotTargetPlatform>Windows</GodotTargetPlatform>
        <GodotPlatform>Windows</GodotPlatform>
        <GodotTargetArchitecture>x86_64</GodotTargetArchitecture>
        <GodotApiConfiguration>Release</GodotApiConfiguration>
        <GodotRealTIsDouble>false</GodotRealTIsDouble>
        <EnableGodotGenerators>true</EnableGodotGenerators>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="GodotSharp">
            <HintPath>$(GameInstallDir)\data_Atomcraft_windows_x86_64\GodotSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <PackageReference Include="Godot.SourceGenerators" Version="4.4.0">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="GodotProjectDir" />
        <CompilerVisibleProperty Include="GodotTargetPlatform" />
        <CompilerVisibleProperty Include="GodotPlatform" />
        <CompilerVisibleProperty Include="GodotTargetArchitecture" />
        <CompilerVisibleProperty Include="GodotApiConfiguration" />
        <CompilerVisibleProperty Include="GodotRealTIsDouble" />
        <CompilerVisibleProperty Include="EnableGodotGenerators" />
    </ItemGroup>

    <Target Name="RemoveDepsJson" AfterTargets="Publish">
        <Delete Files="$(PublishDir)$(AssemblyName).deps.json" />
    </Target>

</Project>
